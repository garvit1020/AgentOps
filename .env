# ============================================================
# AgentOps - Environment Variables
# ============================================================

# --- AI / LLM (REQUIRED for real AI output) ---
# Get a FREE key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-70b-versatile

# --- GitHub (REQUIRED for real repo analysis) ---
# Create at: https://github.com/settings/tokens
# Scopes needed: repo, workflow, read:packages
GITHUB_TOKEN=your_github_personal_access_token
GITHUB_REPO=garvit1020/AgentOps
GITHUB_WEBHOOK_SECRET=agentops_secret_123

# --- Backend ---
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000
AGENT_SERVER_URL=http://localhost:8000

# --- Demo Mode (true = works without Docker/K8s) ---
DEMO_MODE=true

# --- Database ---
DB_PATH=./data/agentops.db

# --- Monitoring (optional) ---
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
