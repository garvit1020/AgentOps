# ============================================================
# AgentOps - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ----- AI / LLM -----
GROQ_API_KEY=your_groq_api_key_here          # Get free key at https://console.groq.com
GROQ_MODEL=llama-3.1-70b-versatile

# ----- GitHub -----
GITHUB_TOKEN=your_github_personal_access_token  # Needs: repo, workflow, read:packages scopes
GITHUB_REPO=garvit1020/AgentOps
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here   # Any random string

# ----- Docker -----
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_PASSWORD=your_dockerhub_password
DOCKER_REGISTRY=docker.io                        # or ECR URL for AWS

# ----- AWS (Optional - for production deployment) -----
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your_12_digit_account_id
ECR_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

# ----- Backend -----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# ----- Python Agent Server -----
AGENT_SERVER_URL=http://localhost:8000
AGENT_SERVER_PORT=8000

# ----- Database -----
DB_PATH=./data/agentops.db

# ----- Monitoring -----
PROMETHEUS_URL=http://localhost:9090
GRAFANA_URL=http://localhost:3001
LOKI_URL=http://localhost:3100

# ----- Kubernetes -----
K8S_NAMESPACE=agentops
K8S_CONTEXT=minikube                            # or your cluster context name

# ----- Demo Mode (set to true if running without real K8s/Docker) -----
DEMO_MODE=true
